# คัดลอกไฟล์นี้เป็น .env แล้วกรอกบัญชี LandsMaps ของคุณ (.env อยู่ใน .gitignore แล้ว)
# ใช้บรรทัดเดียวตามชนิดบัญชีที่ใช้ล็อกอินเว็บ landsmaps.dol.go.th
#
# บัญชีเก็บได้ 2 ที่ โปรแกรมอ่านไฟล์นี้ก่อน แล้วค่อย Access_Key.txt
# ดูว่าตอนนี้เก็บอะไรไว้ที่ไหน: python get_token.py --where

LANDSMAPS_DGA_ID=1234567890123          # บัญชีทางรัฐ (ปุ่ม "เข้าสู่ระบบด้วย DGA")
# LANDSMAPS_MAIL=you@example.com        # บัญชีอีเมล
# LANDSMAPS_PERSONAL_ID=1234567890123   # บัญชีเลขประจำตัวประชาชน (ของกรมที่ดินเอง)
# LANDSMAPS_USERNAME=yourname           # บัญชีเจ้าหน้าที่กรมที่ดิน (AD)

LANDSMAPS_PASSWORD=your-password
