# คัดลอกไฟล์นี้เป็น .env แล้วกรอกบัญชีทางรัฐ (DGA) ของคุณ (.env อยู่ใน .gitignore แล้ว)
# ใช้บัญชีเดียวกับปุ่ม "เข้าสู่ระบบด้วย DGA" ในเว็บ landsmaps.dol.go.th
#
# บัญชีเก็บได้ 2 ที่ โปรแกรมอ่านไฟล์นี้ก่อน แล้วค่อย Access_Key.txt
# ดูว่าตอนนี้เก็บอะไรไว้ที่ไหน: python get_token.py --where
#
# รหัสผ่านที่มี # ช่องว่าง หรือเครื่องหมายคำพูด ให้ครอบด้วย ' ' เช่น LANDSMAPS_PASSWORD='abc #123'

LANDSMAPS_DGA_ID=1234567890123          # เลขประจำตัวประชาชน / ชื่อผู้ใช้ / อีเมล ของบัญชีทางรัฐ
LANDSMAPS_PASSWORD=your-password
